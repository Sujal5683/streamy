{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnterpriseSecurity": {
    "ControlPlaneUrl": "https://remote.corp.internal",
    "SatTokenTtlSeconds": 60,
    "RequireAttendedConsentDefault": true,
    "MaxEnrollmentAttemptsPerMinute": 5,
    "OpenIdConnect": {
      "Authority": "https://login.microsoftonline.com/{TENANT_ID}/v2.0",
      "ClientId": "{AZURE_CLIENT_ID}",
      "Audience": "api://enterprise-remote-access",
      "AllowedTenantIds": [
        "{TENANT_ID}"
      ]
    },
    "TurnServers": [
      {
        "Urls": "turn:turn.corp.internal:3478",
        "Username": "enterprise-relay-user",
        "Credential": "{TURN_SECRET_KEY}"
      }
    ],
    "Audit": {
      "SiemSyslogHost": "siem.corp.internal",
      "SiemSyslogPort": 514,
      "Format": "CEF"
    }
  }
}
